# Copy this file to backend/.env and fill in what you have. backend/.env is git-ignored.

# Optional. Drive times with live traffic from TomTom (free key: https://developer.tomtom.com/).
# Without it, drive times come from OSRM road routing (no traffic).
TOMTOM_API_KEY=

# Optional. Comma-separated sites allowed to call the API (defaults to the local dev servers).
# FRONTEND_ORIGINS=https://your-site.example.com
